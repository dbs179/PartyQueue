# ---- Spotify (required) ----
# Prefer entering Client ID / Secret / Redirect URI / Market in the app:
#   Settings → Spotify  (saved to data/spotify-app.json, gitignored).
# Set them here instead for Docker/UnRaid; env values override the file.
# Create an app at https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_MARKET=US
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/callback

# ---- Spotify playlists (one-time host login) ----
# To show YOUR playlists (incl. private/collaborative), the host connects once
# via the "Connect Spotify" button. Register the Redirect URI above in the
# Spotify dashboard (Settings -> Redirect URIs). Loopback (127.0.0.1) is allowed
# by Spotify without HTTPS; do the one-time login on the machine running the app.
#
# After connecting, a refresh token is saved to data/spotify-tokens.json.
# For Docker, you can instead paste that refresh token here so playlists work
# without mounting a volume. Leave blank when using the on-disk store.
SPOTIFY_REFRESH_TOKEN=

# ---- Last.fm (optional, powers Genre filters) ----
# Prefer Settings → Last.fm (saved to data/lastfm.json). Env overrides the file.
# Get a free key at https://www.last.fm/api/account/create
# LASTFM_API_KEY=

# ---- Sonos ----
# Region used when handing Spotify tracks to Sonos.
# Use "NorthAmerica" for US/Canada, or "EU" for Europe.
SONOS_REGION=NorthAmerica

# Optional: target a specific Sonos room by name (e.g. "Living Room"). Songs are
# added to the queue of that room's group (the whole house if grouped).
# Leave blank to auto-pick the first group's coordinator.
# Prefer DJ Booth → Settings → Connections → Sonos (saved to data/sonos.json).
SONOS_ROOM=
# Optional but recommended when discovery fails (VLANs, VPN, Docker): pin a
# speaker IP. Prefer Settings → Connections → Sonos; env overrides the file.
# Leave blank to auto-discover on the local network.
SONOS_HOST=

# ---- Server ----
PORT=8080

# API requests must carry a LAN-plausible Host header (DNS-rebinding guard).
# IP addresses, single-label names (http://tower:8080), *.local, localhost, and
# the PUBLIC_BASE_URL hostname always work. Add extra dotted hostnames here
# (comma-separated), e.g. a Tailscale MagicDNS name:
# PARTYQUEUE_ALLOWED_HOSTS=partyqueue.mytailnet.ts.net

# Logging: leave blank for human-readable [scope] lines in Unraid/Docker logs.
# Set to "json" for one structured object per line (log shippers).
# LOG_FORMAT=json

# Public URL Sonos uses to fetch silence/TTS media (and the Join QR code).
# Docker/Unraid: set to the host URL Sonos can reach (host networking), e.g.
#   PUBLIC_BASE_URL=http://YOUR_UNRAID_IP:8080
# On a local Windows/Mac run the app ignores a mismatched value and auto-detects
# a LAN IP unless you set PUBLIC_BASE_URL_FORCE=1.
# PUBLIC_BASE_URL=http://YOUR_UNRAID_IP:8080

# ---- Home Assistant (optional, DJ voice announcements) ----
# Prefer entering these in Settings → Home Assistant (saved to
# data/home-assistant.json). Set them here instead for Docker/UnRaid so the
# container gets credentials without a UI visit. Env values override the file.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# Local installs only: override ffmpeg location for non-1x TTS speed.
# Docker already includes ffmpeg.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# ---- Host PIN (optional) ----
# Prefer setting the PIN in the app: Settings → Connections → Host PIN
# (stored hashed in data/host-pin.json). SETTINGS_PIN below is a fallback for
# Docker bootstrap; saving a PIN in the UI clears this env value. Without this
# value, the first UI PIN requires the short-lived setup code printed at startup.
# Gates DJ Booth + host APIs. Party Controls remain open unless the host enables
# "Host-only controls" in Music Mix.
# Example: SETTINGS_PIN=1234
SETTINGS_PIN=
