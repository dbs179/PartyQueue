{
  "name": "partyqueue",
  "version": "10.2.20",
  "description": "A LAN party app for guests to search Spotify and add songs to your Sonos queue, with Random, Never-Ending, Vibe, and optional DJ Voice.",
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run build:client && node --env-file-if-exists=.env src/server.js",
    "dev": "npm run build:client && node --watch --env-file-if-exists=.env src/server.js",
    "build:client": "node scripts/build-client.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "test:browser": "playwright test --project=chromium",
    "deploy:unraid": "powershell -ExecutionPolicy Bypass -File scripts/deploy-unraid.ps1",
    "smoke:supersede": "node --env-file-if-exists=.env scripts/smoke-announce-supersede.mjs",
    "smoke:sticky": "node --env-file-if-exists=.env scripts/smoke-volume-sticky.mjs",
    "package:share": "powershell -ExecutionPolicy Bypass -File scripts/package-share.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@svrooij/sonos": "^2.5.0",
    "express": "^4.19.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.25.9",
    "eslint": "^10.7.0",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0"
  }
}
